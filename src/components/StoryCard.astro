---
import StoryImage from "./StoryImage.astro";
import { formatStoryDate, isoDate, type Story } from "../lib/stories";
import { animalSpot } from "../lib/animals";

interface Props {
    story: Story;
    headingLevel?: "h2" | "h3";
}

const { story, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<li class="h-full">
    <article
        class="group relative h-full flex flex-col bg-surface border border-surface-variant rounded-lg overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 focus-within:shadow-xl"
    >
        <div class="overflow-hidden">
            <StoryImage
                src={story.featuredImage}
                alt={story.featuredImageAlt}
                widths={[400, 640, 800]}
                sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
                class="aspect-[1200/630] transition-transform duration-500 group-hover:scale-105"
            />
        </div>
        <div class="relative flex flex-col gap-sm p-lg flex-1" {...animalSpot("corner", "stories")}>
            <div class="flex flex-wrap items-center gap-sm text-label-sm text-on-surface-variant">
                <span class="bg-surface-container-high text-on-surface font-label-bold uppercase tracking-wide px-sm py-xs rounded-full">
                    {story.category}
                </span>
                <time datetime={isoDate(story.publishedAt)}>{formatStoryDate(story.publishedAt)}</time>
            </div>
            <Heading class="font-headline-md text-headline-md text-on-surface">
                <a
                    href={`/stories/${story.slug}/`}
                    class="after:absolute after:inset-0 after:content-[''] focus:outline-none focus-visible:after:outline focus-visible:after:outline-[3px] focus-visible:after:outline-offset-[-3px] focus-visible:after:outline-on-surface focus-visible:after:rounded-lg"
                >
                    {story.title}
                </a>
            </Heading>
            <p class="font-body-md text-body-md text-on-surface-variant cv-clamp-3">{story.description}</p>
            <p class="mt-auto pt-sm text-label-sm text-on-surface-variant">By {story.author} · {story.readingMinutes} min read</p>
        </div>
    </article>
</li>
