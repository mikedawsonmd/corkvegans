---
import StoryImage from "./StoryImage.astro";
import { categorySlug, categoryUrl, formatStoryDate, isoDate, type Story } from "../lib/stories";
import { animalSpot as spot } from "../lib/animals";

interface Props {
    story: Story;
    headingLevel?: "h2" | "h3";
    /** Animals may stand on this card (use on the first card only). */
    animalSpot?: boolean;
}

const { story, headingLevel = "h3", animalSpot = false } = Astro.props;
const Heading = headingLevel;
// Read by the Stories page filters (src/scripts/story-filters.ts).
const searchText = [story.title, story.description, story.author, story.category].join(" ").toLowerCase();
---

<li
    class="h-full"
    data-story
    data-category={categorySlug(story.category)}
    data-date={isoDate(story.publishedAt)}
    data-title={story.title}
    data-text={searchText}
>
    <!-- White to stand off the pink sections; pink inside a white section. -->
    <article
        {...(animalSpot ? spot("ledge", "stories", { size: 32, max: 2, hop: true }) : {})}
        class="group relative h-full flex flex-col bg-surface-container-lowest [.bg-surface-container-lowest_&]:bg-surface border border-surface-variant rounded-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 focus-within:shadow-xl"
    >
        <div class="overflow-hidden rounded-t-[23px]">
            <StoryImage
                src={story.featuredImage}
                alt={story.featuredImageAlt}
                widths={[400, 640, 800]}
                sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
                class="aspect-[1200/630] transition-transform duration-500 group-hover:scale-105"
            />
        </div>
        <div class="flex flex-col gap-sm p-lg flex-1">
            <div class="flex flex-wrap items-center gap-sm text-label-sm text-on-surface-variant">
                <a
                    href={categoryUrl(story.category)}
                    class="relative z-10 bg-surface-container-high text-on-surface font-label-bold uppercase tracking-wide px-sm py-xs rounded-full hover:bg-surface-variant"
                    aria-label={`More ${story.category} stories`}
                >
                    {story.category}
                </a>
                <time datetime={isoDate(story.publishedAt)}>{formatStoryDate(story.publishedAt)}</time>
            </div>
            <Heading class="font-headline-md text-headline-md text-on-surface">
                <a
                    href={`/stories/${story.slug}/`}
                    class="after:absolute after:inset-0 after:content-[''] focus:outline-none focus-visible:after:outline focus-visible:after:outline-[3px] focus-visible:after:outline-offset-[-3px] focus-visible:after:outline-on-surface focus-visible:after:rounded-lg"
                >
                    {story.title}
                </a>
            </Heading>
            <p class="font-body-md text-body-md text-on-surface-variant cv-clamp-3">{story.description}</p>
            <p class="mt-auto pt-sm text-label-sm text-on-surface-variant">By {story.author} · {story.readingMinutes} min read</p>
        </div>
    </article>
</li>
