---
import Animal from "./Animal.astro";
import { headerCta, nav, socials } from "../config/site";

const year = new Date().getFullYear();
const footerLinks = [...nav, { label: "Contact", href: "/about/#contact" }, headerCta];
const linkClass =
    "font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors !text-on-primary/80 hover:!text-white underline-offset-4 hover:underline";
---

<!-- Footer -->
<footer
    class="w-full shadow-lg !shadow-none !rounded-none pb-md rounded-t-[32px] pt-[84px] md:pt-[100px]"
    style="background-color: rgb(255, 220, 188)"
>
    <div
        data-surface="dark"
        class="relative flex flex-col gap-lg px-xl py-lg w-[calc(100%-2*theme(spacing.margin-mobile))] max-w-7xl mx-auto bg-primary text-on-primary shadow-lg mb-md rounded-lg"
    >
        <!-- Animals standing on the panel: a random group on each page load
             (AnimalSpots.astro); this pair shows if scripts don't run. -->
        <div data-animal-footer class="cv-footer-scene" aria-hidden="true">
            <Animal name="pig" face="right" />
            <Animal name="chicken" face="right" />
        </div>
        <div class="flex flex-col md:flex-row items-center justify-between gap-md">
            <a
                href="/"
                class="flex items-center gap-sm shrink-0 transition-transform duration-200 active:scale-95"
                aria-label="Cork Vegans home"
                ><img
                    alt="Cork Vegans logo"
                    class="w-auto object-contain h-[48px] transition-all duration-300 brightness-0 invert"
                    src="/images/logo.png"
                    width="466"
                    height="332"
                    loading="lazy"
                />
            </a>

            <nav aria-label="Footer">
                <ul class="flex flex-wrap justify-center gap-x-lg gap-y-sm">
                    {
                        footerLinks.map((item) => (
                            <li>
                                <a class={linkClass} href={item.href}>
                                    {item.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <p class="font-body-md text-body-md text-on-surface-variant !text-on-primary/80">© {year} Cork Vegans</p>
        </div>

        <div class="border-t border-white/20 pt-lg flex justify-center">
            <ul class="flex items-center gap-md" aria-label="Cork Vegans on social media">
                {
                    socials.map((s) => (
                        <li>
                            <a
                                href={s.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex items-center justify-center w-[44px] h-[44px] rounded-full ring-2 ring-white/30 hover:ring-white transition-all hover:scale-110 active:scale-95"
                                style={`background: ${s.color}`}
                            >
                                <img src={s.icon} alt="" width="22" height="22" class="w-[22px] h-[22px] object-contain" loading="lazy" />
                                <span class="sr-only">Cork Vegans on {s.label} (opens in a new tab)</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</footer>
