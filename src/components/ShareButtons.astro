---
/**
 * Share actions for a story. Direct share links work without JavaScript;
 * "Copy link" and the device share sheet are added when the browser supports them.
 */
interface Props {
    url: string;
    title: string;
}

const { url, title } = Astro.props;
const enc = encodeURIComponent;
const direct = [
    { label: "WhatsApp", href: `https://wa.me/?text=${enc(`${title} ${url}`)}` },
    { label: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}` },
    { label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}` },
    { label: "Email", href: `mailto:?subject=${enc(title)}&body=${enc(url)}` },
];
const pill = "cv-btn cv-btn-sm cv-btn-secondary";
---

<section data-share data-url={url} data-title={title} aria-labelledby="share-heading" class="flex flex-col gap-md">
    <h2 id="share-heading" class="font-label-bold text-label-bold uppercase tracking-[0.15em] text-on-surface-variant">Share this story</h2>
    <ul class="flex flex-wrap gap-sm">
        <li data-native-share hidden>
            <button type="button" class={pill}>
                <span class="material-symbols-outlined" aria-hidden="true">share</span>Share…
            </button>
        </li>
        <li data-copy-link hidden>
            <button type="button" class={pill}>
                <span class="material-symbols-outlined" aria-hidden="true">link</span>Copy link
            </button>
        </li>
        {
            direct.map((d) => (
                <li>
                    <a class={pill} href={d.href} target={d.label === "Email" ? undefined : "_blank"} rel="noopener noreferrer">
                        {d.label}
                        {d.label !== "Email" && <span class="sr-only"> (opens in a new tab)</span>}
                    </a>
                </li>
            ))
        }
    </ul>
    <p data-share-status role="status" aria-live="polite" class="text-label-sm text-on-surface-variant min-h-[16px]"></p>
</section>

<script>
    document.querySelectorAll<HTMLElement>("[data-share]").forEach((root) => {
        const url = root.dataset.url ?? window.location.href;
        const title = root.dataset.title ?? document.title;
        const status = root.querySelector<HTMLElement>("[data-share-status]");
        const say = (msg: string) => {
            if (status) status.textContent = msg;
        };

        const nativeItem = root.querySelector<HTMLElement>("[data-native-share]");
        if (nativeItem && typeof navigator.share === "function") {
            nativeItem.hidden = false;
            nativeItem.querySelector("button")?.addEventListener("click", async () => {
                try {
                    await navigator.share({ title, url });
                } catch (err) {
                    if ((err as DOMException).name !== "AbortError") say("Sharing isn't available right now — try copying the link instead.");
                }
            });
        }

        const copyItem = root.querySelector<HTMLElement>("[data-copy-link]");
        if (copyItem && navigator.clipboard?.writeText) {
            copyItem.hidden = false;
            copyItem.querySelector("button")?.addEventListener("click", async () => {
                try {
                    await navigator.clipboard.writeText(url);
                    say("Link copied to clipboard.");
                } catch {
                    say(`Couldn't copy automatically. The link is: ${url}`);
                }
            });
        }
    });
</script>
