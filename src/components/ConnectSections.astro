---
/** The original "Get connected" and "Resources" bands. */
import LinkTile from "./LinkTile.astro";
import { links } from "../config/site";
---

<!-- Social Connect Section -->
<section
    class="pt-xl pb-md relative overflow-hidden text-on-tertiary"
    style="background-color: rgb(255, 220, 188)"
    id="communityLinks"
    aria-labelledby="connect-heading"
>
    <div class="max-w-7xl mx-auto px-margin-mobile relative z-10">
        <div class="flex flex-col items-center text-center gap-lg">
            <h2 id="connect-heading" class="font-headline-lg text-headline-lg font-extrabold text-on-surface">
                Get connected
            </h2>
            <p class="font-body-lg text-body-lg max-w-xl opacity-90 text-on-surface-variant">
                Stay in the loop with events, food pics, and other updates. Choose your favorite platforms and jump in!
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-md w-full mt-md max-w-5xl lg:grid-cols-3">
                <LinkTile
                    href={links.meetup}
                    icon="/images/socials/meetup.png"
                    label="Meetup"
                    sublabel="Cork Vegans"
                    circleStyle="background-color: rgb(255, 74, 121)"
                />
                <LinkTile
                    href={links.facebook}
                    icon="/images/socials/facebook.png"
                    label="Facebook"
                    sublabel="Cork Vegans"
                    circleClass="bg-[#1877F2]"
                />
                <LinkTile
                    href={links.instagram}
                    icon="/images/socials/insta.png"
                    label="Instagram"
                    sublabel="@corkvegans"
                    circleClass="bg-gradient-to-tr from-[#f9ce34] via-[#ee2a7b] to-[#6228d7]"
                />
            </div>
        </div>
    </div>
</section>
<!-- Resources Section -->
<section
    class="pt-xl pb-md relative overflow-hidden text-on-tertiary"
    style="background-color: rgb(255, 220, 188)"
    id="resources"
    aria-labelledby="resources-heading"
>
    <div class="max-w-7xl mx-auto px-margin-mobile relative z-10">
        <div class="flex flex-col items-center text-center gap-lg">
            <h2 id="resources-heading" class="font-headline-lg text-headline-lg font-extrabold text-on-surface">
                Resources
            </h2>
            <p class="font-body-lg text-body-lg max-w-xl opacity-90 text-on-surface-variant">
                Useful links and resources for all things vegan, including our Cork vegan food map and WhatsApp
                community!
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-md w-full mt-md max-w-5xl lg:grid-cols-3">
                <LinkTile
                    href={links.whatsapp}
                    icon="/images/socials/whatsapp.png"
                    label="WhatsApp"
                    sublabel="Join our community"
                    circleClass="bg-[#25D366]"
                />
                <LinkTile
                    href={links.foodMap}
                    icon="/images/socials/foodmap.png"
                    label="Dining out"
                    sublabel="Cork vegan food map"
                    circleStyle="background-color: #417660"
                />
            </div>
        </div>
    </div>
</section>
