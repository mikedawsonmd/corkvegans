---
/** Top-of-page heading block for inner pages, using the site's section heading pattern. */
import SectionHeading from "./SectionHeading.astro";
import { animalSpot } from "../lib/animals";

interface Props {
    eyebrow?: string;
    title: string;
    intro?: string;
    accent?: string;
    eyebrowColor?: string;
}
const props = Astro.props;
---

<section class="relative pt-xl pb-sm bg-surface" {...animalSpot("floor", "header", { room: true })}>
    <div class="max-w-7xl mx-auto px-margin-mobile pt-lg">
        <SectionHeading {...props} level="h1" />
        <slot />
    </div>
</section>
