---
import type { GetStaticPaths } from "astro";
import StoriesListing from "../../../components/StoriesListing.astro";
import { getStories } from "../../../lib/content";
import { STORIES_PER_PAGE } from "../../../lib/stories";

export const getStaticPaths = (() => {
    const lastPage = Math.ceil(getStories().length / STORIES_PER_PAGE);
    // Page 1 lives at /stories/; this route only builds pages 2 and up.
    return Array.from({ length: Math.max(0, lastPage - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}) satisfies GetStaticPaths;

const all = getStories();
const currentPage = Number(Astro.params.page);
const lastPage = Math.ceil(all.length / STORIES_PER_PAGE);
const stories = all.slice((currentPage - 1) * STORIES_PER_PAGE, currentPage * STORIES_PER_PAGE);
---

<StoriesListing stories={stories} currentPage={currentPage} lastPage={lastPage} />
