---
import type { GetStaticPaths } from "astro";
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import StoryCard from "../../components/StoryCard.astro";
import StoryImage from "../../components/StoryImage.astro";
import { getStories, getStoryImage } from "../../lib/content";
import { enhanceStoryHtml, renderStoryMarkdown } from "../../lib/markdown";
import { articleJsonLd } from "../../lib/seo";
import { categoryUrl, formatStoryDate, isoDate, relatedStories, storyImageKey, type Story } from "../../lib/stories";
import { site } from "../../config/site";

export const getStaticPaths = (() =>
    getStories().map((story) => ({ params: { slug: story.slug }, props: { story } }))) satisfies GetStaticPaths;

const { story } = Astro.props as { story: Story };
const canonical = new URL(`/stories/${story.slug}/`, site.url).href;

// Social image: the featured image cropped to 1200 × 630, or the branded default.
const featured = getStoryImage(story.featuredImage);
const shareImage = featured
    ? {
          src: (await getImage({ src: featured, width: 1200, height: 630, fit: "cover", position: "center", format: "jpg", quality: 82 })).src,
          width: 1200,
          height: 630,
          alt: story.featuredImageAlt,
      }
    : site.defaultShareImage;
const shareImageUrl = new URL(shareImage.src, site.url).href;

// Article body: Markdown → sanitised HTML → optimised, lazy-loaded images.
const bodyHtml = await enhanceStoryHtml(renderStoryMarkdown(story.body), async (src) => {
    if (!storyImageKey(src)) return null;
    const image = getStoryImage(src);
    if (!image) return false; // file was deleted or never uploaded: drop it rather than show a broken image
    const out = await getImage({ src: image, width: Math.min(1360, image.width), format: "webp", quality: 75 });
    return { src: out.src, width: Number(out.attributes.width), height: Number(out.attributes.height) };
});

const related = relatedStories(story, getStories());
const updated = story.updatedAt;
---

<BaseLayout
    title={story.title}
    description={story.description}
    type="article"
    image={shareImage}
    article={{
        publishedTime: story.publishedAt.toISOString(),
        modifiedTime: updated?.toISOString(),
        author: story.author,
        section: story.category,
    }}
    jsonLd={[articleJsonLd(story, canonical, shareImageUrl)]}
>
    <article class="bg-surface pb-xl">
        <header class="max-w-4xl mx-auto px-margin-mobile pt-xl">
            <a
                href="/stories/"
                class="group inline-flex items-center gap-xs min-h-[44px] font-label-bold text-label-bold text-primary"
            >
                <span class="material-symbols-outlined text-[20px] transition-transform group-hover:-translate-x-1" aria-hidden="true">arrow_back</span>
                <span class="group-hover:underline underline-offset-4">All stories</span>
            </a>
            <div class="mt-md flex flex-wrap items-center gap-sm">
                <a
                    href={categoryUrl(story.category)}
                    class="bg-surface-container-high text-on-surface font-label-bold text-label-sm uppercase tracking-wide px-sm py-xs rounded-full hover:bg-surface-variant"
                    aria-label={`More ${story.category} stories`}
                >
                    {story.category}
                </a>
            </div>
            <h1 class="mt-md font-headline-lg-mobile text-headline-lg-mobile md:font-display-lg md:text-display-lg text-on-surface">
                {story.title}
            </h1>
            <p class="mt-md font-body-lg text-body-lg text-on-surface-variant max-w-[68ch]">{story.description}</p>
            <p class="mt-md text-label-bold text-on-surface-variant flex flex-wrap gap-x-sm gap-y-xs">
                <span>By {story.author}</span>
                <span aria-hidden="true">·</span>
                <time datetime={isoDate(story.publishedAt)}>{formatStoryDate(story.publishedAt)}</time>
                {
                    updated && (
                        <>
                            <span aria-hidden="true">·</span>
                            <span>
                                Updated <time datetime={isoDate(updated)}>{formatStoryDate(updated)}</time>
                            </span>
                        </>
                    )
                }
                <span aria-hidden="true">·</span>
                <span>{story.readingMinutes} min read</span>
            </p>
        </header>

        {
            featured && (
                <figure class="max-w-5xl mx-auto px-margin-mobile mt-xl">
                    <StoryImage
                        src={story.featuredImage}
                        alt={story.featuredImageAlt}
                        widths={[640, 960, 1280, 1600]}
                        sizes="(min-width: 1024px) 1024px, 100vw"
                        class="rounded-lg shadow-xl aspect-[1200/630]"
                        eager
                    />
                </figure>
            )
        }

        <div class="max-w-4xl mx-auto px-margin-mobile mt-xl">
            <div class="cv-prose" set:html={bodyHtml} />

            <div class="mt-xl pt-lg border-t border-surface-variant">
                <ShareButtons url={canonical} title={story.title} />
            </div>
        </div>
    </article>

    {
        related.length > 0 && (
            <section class="pt-xl pb-xl bg-surface-container-lowest" aria-labelledby="related-heading">
                <div class="max-w-7xl mx-auto px-margin-mobile">
                    <h2 id="related-heading" class="font-headline-lg text-headline-lg text-on-surface mb-lg text-center">
                        More stories
                    </h2>
                    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">
                        {related.map((s) => (
                            <StoryCard story={s} />
                        ))}
                    </ul>
                    <div class="flex justify-center mt-xl">
                        <a href="/stories/" class="cv-btn cv-btn-md cv-btn-primary">
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                            Back to all stories
                        </a>
                    </div>
                </div>
            </section>
        )
    }
</BaseLayout>
