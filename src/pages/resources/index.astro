---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LinkTile from "../../components/LinkTile.astro";
import PageHeader from "../../components/PageHeader.astro";
import { resources } from "../../config/site";

const items = resources.filter((r) => /^https:\/\//.test(r.href));
const description = "Useful links for vegans in Cork: our WhatsApp community, the Cork vegan food map and more.";
---

<BaseLayout title="Resources" description={description}>
    <PageHeader
        eyebrow="Resources"
        title="Useful links"
        intro="Handy resources for all things vegan in Cork, from our community chat to where to eat."
        accent="#417660"
        eyebrowColor="#275d49"
    />
    <section class="pt-xl pb-xl" style="background-color: rgb(255, 220, 188)" aria-label="Resource links">
        <div class="max-w-7xl mx-auto px-margin-mobile">
            <ul class="flex flex-wrap justify-center gap-md max-w-5xl mx-auto">
                {
                    items.map((r, i) => (
                        <li class="w-full md:w-[calc((100%-16px)/2)] lg:w-[calc((100%-32px)/3)]">
                            <LinkTile href={r.href} label={r.title} sublabel={r.description} image={r.image} icon={r.icon} color={r.color} animalSpot={i === 0} />
                        </li>
                    ))
                }
            </ul>
            <p class="mt-xl text-center text-body-md text-on-surface">
                Know a great vegan-friendly place, business or product in Cork?{" "}
                <a href="/about/?topic=recommend#contact" class="font-label-bold text-primary underline underline-offset-2">Recommend it</a>.
            </p>
        </div>
    </section>
</BaseLayout>
