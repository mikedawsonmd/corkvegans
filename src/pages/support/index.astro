---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import VolunteerForm from "../../components/VolunteerForm.astro";
import { donations } from "../../config/site";

const description = "Support Cork Vegans by making a one-off or monthly donation, or by volunteering with the community.";

// Wording below is a starting point. Organisers should review it before launch
// and keep it accurate (see docs/ADMIN-GUIDE.md → "Support page wording").
const donationAims = [
    { icon: "groups", text: "Organising community events, socials and potlucks" },
    { icon: "campaign", text: "Community outreach and promoting vegan living locally" },
    { icon: "accessible", text: "Making our events more accessible and welcoming" },
    { icon: "school", text: "Educational activities and resources" },
];

const options = [
    {
        id: "once",
        title: "Give once",
        text: "Make a single donation of any amount.",
        url: donations.oneOffUrl.trim(),
        cta: "Donate once",
    },
    {
        id: "monthly",
        title: "Give monthly",
        text: "Set up a regular monthly donation. You can cancel at any time through the payment provider.",
        url: donations.monthlyUrl.trim(),
        cta: "Donate monthly",
    },
];
const isHttps = (u: string) => /^https:\/\//.test(u);
const provider = donations.providerName.trim();
const anyConfigured = options.some((o) => isHttps(o.url));

const roles = [
    { icon: "event", title: "Event organisation", text: "Plan socials, dining nights, walks and potlucks." },
    { icon: "front_hand", title: "Event-day support", text: "Welcome newcomers and help things run smoothly." },
    { icon: "photo_camera", title: "Photography and video", text: "Capture our events and community." },
    { icon: "edit_note", title: "Writing and storytelling", text: "Write stories, reviews and event recaps." },
    { icon: "share", title: "Social media and communications", text: "Help spread the word online." },
    { icon: "diversity_3", title: "Community outreach", text: "Connect with local groups and businesses." },
];
---

<BaseLayout title="Support us" description={description}>
    <PageHeader
        eyebrow="Get involved"
        title="Support Cork Vegans"
        intro="Cork Vegans is powered by its community. Whether you can give a little money or a little time, it all helps."
        accent="#417660"
        eyebrowColor="#275d49"
    >
        <nav aria-label="On this page" class="flex flex-wrap justify-center gap-md pb-lg">
            <a href="#donate" class="cv-btn cv-btn-sm cv-btn-secondary">
                <span class="material-symbols-outlined" aria-hidden="true">favorite</span>Donate
            </a>
            <a href="#volunteer" class="cv-btn cv-btn-sm cv-btn-secondary">
                <span class="material-symbols-outlined" aria-hidden="true">volunteer_activism</span>Volunteer
            </a>
        </nav>
    </PageHeader>

    <!-- Donate -->
    <section id="donate" class="pt-xl pb-xl bg-surface-container-lowest" aria-labelledby="donate-heading">
        <div class="max-w-5xl mx-auto px-margin-mobile flex flex-col gap-xl">
            <div class="flex flex-col gap-md">
                <h2 id="donate-heading" class="font-headline-lg text-headline-lg text-on-surface">Donate</h2>
                <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl">Donations help us with things like:</p>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-md">
                    {
                        donationAims.map((a) => (
                            <li class="flex items-start gap-sm p-md rounded-lg bg-surface-container-low border border-surface-variant">
                                <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">{a.icon}</span>
                                <span class="font-body-md text-body-md text-on-surface">{a.text}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <ul class="grid grid-cols-1 md:grid-cols-2 gap-lg">
                {
                    options.map((o) => (
                        <li class="flex flex-col gap-md p-lg rounded-lg bg-surface border border-surface-variant shadow-sm">
                            <h3 class="font-headline-md text-headline-md text-on-surface">{o.title}</h3>
                            <p class="font-body-md text-body-md text-on-surface-variant flex-1">{o.text}</p>
                            {isHttps(o.url) ? (
                                <a
                                    href={o.url}
                                    data-donate={o.id}
                                    class="self-start cv-btn cv-btn-md cv-btn-primary"
                                >
                                    {o.cta}
                                    <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                                    <span class="sr-only">{provider ? ` (continues to ${provider})` : " (continues to our payment provider)"}</span>
                                </a>
                            ) : (
                                <p data-donate-unavailable={o.id} class="self-start cv-btn cv-btn-md cv-btn-placeholder">
                                    Coming soon
                                </p>
                            )}
                        </li>
                    ))
                }
            </ul>

            <p class="flex items-start gap-sm text-body-md text-on-surface-variant">
                <span class="material-symbols-outlined text-primary" aria-hidden="true">lock</span>
                <span>
                    {
                        anyConfigured
                            ? `Donations are handled securely by ${provider || "our payment provider"} on their own website. Cork Vegans never sees or stores your card details.`
                            : "Online donations are coming soon. Payments will be handled securely by our payment provider on their own website — Cork Vegans will never see or store your card details."
                    }
                </span>
            </p>
        </div>
    </section>

    <!-- Volunteer -->
    <section id="volunteer" class="pt-xl pb-xl bg-surface" aria-labelledby="volunteer-heading">
        <div class="max-w-7xl mx-auto px-margin-mobile grid grid-cols-1 lg:grid-cols-2 gap-xl items-start">
            <div class="flex flex-col gap-md">
                <h2 id="volunteer-heading" class="font-headline-lg text-headline-lg text-on-surface">Volunteer with us</h2>
                <p class="font-body-lg text-body-lg text-on-surface-variant">
                    Got a bit of time, a skill to share or just enthusiasm? We'd love to hear from you. No experience
                    needed — tell us what you're interested in and we'll be in touch.
                </p>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-md mt-sm">
                    {
                        roles.map((r) => (
                            <li class="p-md rounded-lg bg-surface-container-low border border-surface-variant flex flex-col gap-xs">
                                <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">{r.icon}</span>
                                <p class="font-label-bold text-label-bold">{r.title}</p>
                                <p class="text-label-sm text-on-surface-variant">{r.text}</p>
                            </li>
                        ))
                    }
                </ul>
            </div>
            <VolunteerForm />
        </div>
    </section>
</BaseLayout>
