{
  "name": "corkvegans",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Cork Vegans community website",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:fixtures": "CV_FIXTURES=1 astro dev",
    "sync:events": "node scripts/sync-events.ts",
    "build": "astro build && node scripts/check-dist.ts dist",
    "build:fixtures": "CV_FIXTURES=1 astro build --outDir dist-fixtures && CV_FIXTURES=1 node scripts/check-dist.ts dist-fixtures",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "npm run build:fixtures && playwright test",
    "ci": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "astro": "7.3.8",
    "marked": "18.1.1",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.19",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/sanitize-html": "2.16.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
